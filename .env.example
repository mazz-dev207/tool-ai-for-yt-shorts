# Fast Pipeline cache
# true = reuse unchanged Whisper/chunks/Qwen discovery work across reruns.
# false = force a fresh upstream analysis without deleting cache folders manually.
FAST_CACHE_ENABLED=true

# Gemini Final Multimodal Judge ONLY
# Hook START, V3 Editorial and Viewer Satisfaction run locally on Qwen/Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_ENABLED=true
HIGHLIGHT_MODE=legacy
CONTENT_PROFILE=auto

# Cost / quality controls
GEMINI_CONTEXT_BEFORE=8
GEMINI_CONTEXT_AFTER=8
# Spend Gemini quota only on the strongest local candidates.
GEMINI_MAX_CANDIDATES=6
GEMINI_TOP_HIGHLIGHTS=5
GEMINI_MIN_SCORE=55
GEMINI_OVERLAP_THRESHOLD=0.60
GEMINI_MAX_RETRIES=2
GEMINI_MIN_REFINED_DURATION=12
GEMINI_MAX_REFINED_DURATION=60

# AI Shorts V3 editorial — local Qwen/Ollama
# Viewer Satisfaction is returned inside the SAME local V3 reasoning request.
V3_ENABLED=true
ENABLE_ORIGINALITY_ENGINE=true
ENABLE_STORY_RESTRUCTURING=true
ENABLE_EDITORIAL_HOOKS=true
ENABLE_RECONSTRUCTED_HOOKS=true
ENABLE_CONTEXT_OVERLAYS=true
ENABLE_SEMANTIC_EFFECTS=true
ENABLE_SOUND_DESIGN=true
ENABLE_ORIGINALITY_QA=true
ORIGINALITY_MIN_SCORE=60
MAX_EDIT_PLAN_RETRIES=2
MAX_EFFECTS_PER_EVENT=2
V3_CONTEXT_BEFORE=8
V3_CONTEXT_AFTER=8
V3_EDITORIAL_PROFILE=mazclips

# Viewer Satisfaction Engine — local Qwen evidence + deterministic scoring
SATISFACTION_ENABLED=true
SATISFACTION_DEBUG=true
MIN_SATISFACTION_SCORE=65
MIN_PAYOFF_SCORE=60
MIN_CONTEXT_SCORE=55
MAX_CLICKBAIT_GAP=45
SATISFACTION_MAX_RETRIES=2
SATISFACTION_MAX_REFINEMENT_PASSES=1
SATISFACTION_FALLBACK_TOP_K=3
# Must stay false when Gemini is reserved only for the Final Multimodal Judge.
SATISFACTION_FINAL_VALIDATION=false

# Final Short Score weights (renormalized automatically when a component is unavailable)
HOOK_WEIGHT=0.25
RETENTION_WEIGHT=0.25
SATISFACTION_WEIGHT=0.20
ORIGINALITY_WEIGHT=0.15
PAYOFF_WEIGHT=0.10
CONTEXT_WEIGHT=0.05

# Caption Hook Engine (local Qwen/Ollama; adds no Gemini calls)
CAPTION_HOOK_ENABLED=true
CAPTION_HOOK_MIN_SCORE=75
CAPTION_HOOK_MAX_WORDS=7
CAPTION_HOOK_MAX_LINES=2
# Canonical on-screen duration for every accepted Caption Hook.
CAPTION_HOOK_DURATION=3.3
CAPTION_HOOK_ALLOW_NONE=true
CAPTION_HOOK_DEBUG=true
# auto = local Qwen then conservative deterministic fallback; local = same without future providers; off = disabled
CAPTION_HOOK_GENERATOR=auto
CAPTION_HOOK_PROMPT_VERSION=caption-hook-v2-3.3s-ass-fix

# Reaction Caption Engine
# Runs on already-cut Shorts only, so it does not scan the full source video.
REACTION_CAPTION_ENABLED=true
REACTION_CAPTION_AUDIO_ENABLED=true
REACTION_CAPTION_MODEL=MIT/ast-finetuned-audioset-10-10-0.4593
# Global minimum probability. Individual risky classes such as scream use a higher internal floor.
REACTION_CAPTION_MIN_SCORE=0.34
REACTION_CAPTION_WINDOW_SECONDS=2.5
REACTION_CAPTION_HOP_SECONDS=0.9
# Prevents noisy accessibility-style spam; only strongest reactions survive.
REACTION_CAPTION_MAX_EVENTS=3
REACTION_CAPTION_MERGE_GAP=0.8

# SmartCut 2.0
SMARTCUT_ENABLED=true
SMARTCUT_DEBUG=true
SMARTCUT_BOUNDARY_SEARCH_WINDOW=1.25
SMARTCUT_PRE_CONTEXT=2.0
SMARTCUT_POST_CONTEXT=2.0
SMARTCUT_SENTENCE_PRE_PADDING=0.08
SMARTCUT_SENTENCE_POST_PADDING=0.12
SMARTCUT_REACTION_SEARCH_WINDOW=1.50
SMARTCUT_REACTION_PADDING=0.25
SMARTCUT_MINIMUM_CUT_SPACING=0.35
SMARTCUT_MINIMUM_SEGMENT_DURATION=0.80
SMARTCUT_DEAD_AIR_THRESHOLD=0.55

# SmartCrop 2.0
SMARTCROP_V2_ENABLED=true
SMARTCROP_DEBUG=true
SMARTCROP_DETECT_GAMEPLAY_WEBCAM=true
SMARTCROP_SAMPLE_INTERVAL=0.50
SMARTCROP_WEBCAM_PERSISTENCE=0.55
SMARTCROP_WEBCAM_MIN_AREA_RATIO=0.004
SMARTCROP_WEBCAM_MAX_AREA_RATIO=0.20
SMARTCROP_WEBCAM_CORNER_ZONE=0.42
SMARTCROP_GAMEPLAY_RATIO=0.72
SMARTCROP_WEBCAM_RATIO=0.28
SMARTCROP_MOVEMENT_DEAD_ZONE=0.06
SMARTCROP_MAX_CROP_VELOCITY=0.18
SMARTCROP_REACTION_EMPHASIS_ENABLED=true
SMARTCROP_REACTION_HOLD_DURATION=1.40
SMARTCROP_FALLBACK_TO_EXISTING=true
